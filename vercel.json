{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/?demo=1",
      "permanent": false,
      "missing": [
        { "type": "query", "key": "demo" },
        { "type": "query", "key": "session" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "@dawin-api-url",
    "VITE_WS_URL": "@dawin-ws-url"
  }
}
