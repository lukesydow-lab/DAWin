# DAWin server environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string.
# For local dev with docker-compose: use the value below as-is.
DATABASE_URL=postgresql://dawin:dawin_dev@localhost:5432/dawin

# ---- Auth -------------------------------------------------------------------
# HS256 secret for JWT signing. Generate a random 32+ character string.
# Example: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying

# ---- CORS -------------------------------------------------------------------
# Allowed origin for browser clients. Use * for local dev.
CORS_ORIGIN=http://localhost:5173

# ---- Server -----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# ---- Cloudflare R2 ----------------------------------------------------------
# All four values are required for audio upload and streaming.
# Find them in the Cloudflare dashboard → R2 → your bucket → Manage R2 API Tokens.

# Your Cloudflare account ID (visible in the dashboard URL and on the R2 overview page).
R2_ACCOUNT_ID=

# R2 API token access key (created under R2 → Manage API Tokens).
R2_ACCESS_KEY_ID=

# R2 API token secret key.
R2_SECRET_ACCESS_KEY=

# The R2 bucket name you created (e.g. "dawin-audio-dev").
R2_BUCKET_NAME=
